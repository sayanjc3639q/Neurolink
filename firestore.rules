rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check: your exact Firebase Auth UID
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'w8MTO5DEg0Miiz8RWCck5tfkE7R2' ||
        request.auth.uid == 'OWNER_UID_MOCK'
      );
    }

    // Writer check: admin OR any user granted access in the writers collection
    function isWriter() {
      return request.auth != null && (
        isAdmin() ||
        exists(/databases/$(database)/documents/writers/$(request.auth.uid))
      );
    }

    // Topics collection
    match /topics/{slug} {
      // Public read
      allow read: if true;

      // Admin or authorized writers can create and update with schema validation
      allow create, update: if isWriter()
        && request.resource.data.slug == slug
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 280
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 20;

      // Admin or authorized writers can delete topics
      allow delete: if isWriter();
    }

    // Metadata collection (search index version invalidation)
    match /meta/{doc} {
      allow read: if true;
      allow write: if isWriter();
    }

    // Writers collection (Admin panel permissions management)
    match /writers/{userId} {
      // Authenticated users can check their own access status
      allow read: if request.auth != null;
      // Only the Admin can grant or revoke writer access
      allow write: if isAdmin();
    }
  }
}
