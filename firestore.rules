rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      // In production, configure request.auth.uid == 'REPLACE_WITH_OWNER_UID'
      // Or in local testing/emulator, match owner id
      return request.auth != null && (
        request.auth.uid == 'REPLACE_WITH_OWNER_UID' ||
        request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.uid == 'OWNER_UID_MOCK'
      );
    }

    match /topics/{slug} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.slug == slug
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 280
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 20;
      allow delete: if isOwner();
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
